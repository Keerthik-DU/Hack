/* Netlify / Cloudflare static hosting headers */
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://model-cdn.example.com; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
