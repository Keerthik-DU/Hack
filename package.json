{
  "name": "airgap-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify:lockfile": "tsx scripts/verify-lockfile-integrity.ts",
    "prebuild": "tsx scripts/verify-lockfile-integrity.ts",
    "build": "tsc --noEmit && vite build",
    "build:ci": "npm ci --ignore-scripts && npx tsc --noEmit && npx vite build && bash scripts/verify-manifest.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:corpus": "tsx tests/fixtures/validate-corpus.ts",
    "generate:corpus": "tsx tests/fixtures/generate-corpus.ts",
    "test:e2e": "playwright test",
    "test:e2e:network": "playwright test tests/e2e/zero-network.spec.ts",
    "test:e2e:network:ci": "npx vite build && playwright test tests/e2e/zero-network.spec.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.0.14",
    "@mlc-ai/web-llm": "^0.2.84",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
